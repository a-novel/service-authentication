# Version control and CI, which no build needs.
.git
.github
.claude

# Node toolchain, large and irrelevant to Go builds.
node_modules

# Test files, kept out of production images.
**/*_test.go
**/*.test.go

# Scripts, docs and frontend sources, which no server build reads. The REST builds copy pkg/go, so
# pkg/ stays in the build context.
scripts
*.md
**/*.ts
**/*.js
coverage/
