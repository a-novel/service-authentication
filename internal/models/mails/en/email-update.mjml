<mjml lang="en" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Confirm your new Agora Storyverse email address
MIME-Version: 1.0
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Confirm your new Agora Storyverse email address</mj-title>
    <mj-preview>Confirm this address to update your account.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#010203">
    <mj-include path="../mj-header.mjml" />
    <mj-wrapper padding="0 16px">
      <mj-section css-class="message-content" background-color="#161a1d" border-radius="12px" padding="32px">
        <mj-column>
          <mj-text mj-class="meta" padding="0 0 16px">Account details</mj-text>
          <mj-text padding="0 0 24px"><h1>Confirm your new email</h1></mj-text>
          <mj-text
            >You requested an email change for your Agora Storyverse account. Confirm this address to complete the
            update.</mj-text
          >
          <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}&amp;source={{.Source}}"
            >Confirm my email</mj-button
          >
          <mj-text mj-class="meta" padding="0 0 32px">Link valid for {{.Duration}} h.</mj-text>
          <mj-text mj-class="support" padding="0"
            >If you didn’t request this, ignore this email. Your current email address will stay the same.</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="24px 24px 0">
      <mj-column>
        <mj-text mj-class="support" padding="0 0 8px">You can also copy this link into your browser:</mj-text>
        <mj-text mj-class="support" padding="0 0 32px">
          <a
            class="fallback-link"
            href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}&amp;source={{.Source}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}&amp;source={{.Source}}</a
          >
        </mj-text>
        <mj-text
          font-family="Lora, Georgia, 'Noto Serif', serif"
          font-size="16px"
          font-style="italic"
          color="#a2a8ab"
          padding="0 0 48px"
        >
          Build worlds worth returning to.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
