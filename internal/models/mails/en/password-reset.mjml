<mjml lang="en" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Reset your Agora password
MIME-Version: 1.0
Content-Type: multipart/related; type="text/html"; boundary="agora-related"

--agora-related
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Reset your Agora password</mj-title>
    <mj-preview>Choose a new password for your account.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#060b0e" css-class="mail">
    <mj-include path="../mj-header.mjml" />
    <mj-wrapper>
      <mj-section mj-class="card">
        <mj-column>
          <mj-text padding="0 0 8px"><h1>Reset your password</h1></mj-text>
          <mj-text padding="0 0 16px"
            >You requested a password reset for your Agora account. Follow the link to choose a new password.</mj-text
          >
          <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}">Reset my password</mj-button>
          <mj-text mj-class="meta" padding="0 0 16px">Link valid for {{.Duration}} h.</mj-text>
          <mj-text mj-class="support"
            >If you didn’t request this, ignore this email. Your password will stay the same.</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="24px 24px 48px">
      <mj-column>
        <mj-text mj-class="support" padding="0 0 8px">You can also copy this link into your browser:</mj-text>
        <mj-text mj-class="support">
          <a class="fallback-link" href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
