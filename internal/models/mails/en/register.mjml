<mjml lang="en" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Create your Agora Storyverse account
MIME-Version: 1.0
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Create your Agora Storyverse account</mj-title>
    <mj-preview>Complete your registration.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#010203">
    <mj-include path="../mj-header.mjml" />
    <mj-wrapper padding="0 16px">
      <mj-section css-class="message-content" background-color="#161a1d" border-radius="12px" padding="32px">
        <mj-column>
          <mj-text padding="0 0 24px"><h1>Create your account</h1></mj-text>
          <mj-text>Complete your registration to join Agora Storyverse.</mj-text>
          <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}">Create my account</mj-button>
          <mj-text mj-class="meta" padding="0 0 32px">Link valid for {{.Duration}} h.</mj-text>
          <mj-text mj-class="support" padding="0">If you didn’t request an account, you can ignore this email.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="24px 24px 0">
      <mj-column>
        <mj-text mj-class="support" padding="0 0 8px">You can also copy this link into your browser:</mj-text>
        <mj-text mj-class="support" padding="0 0 32px">
          <a class="fallback-link" href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
