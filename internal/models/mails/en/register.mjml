<mjml lang="en" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Create your Agora account
MIME-Version: 1.0
Content-Type: multipart/related; type="text/html"; boundary="agora-related"

--agora-related
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Create your Agora account</mj-title>
    <mj-preview>Complete your registration.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#060b0e" css-class="mail">
    <mj-include path="../mj-header.mjml" />
    <mj-section padding="0 24px 48px">
      <mj-column>
        <mj-text padding="0 0 8px"><h1>Create your account</h1></mj-text>
        <mj-text padding="0 0 24px">Complete your registration to join Agora.</mj-text>
        <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}">Create my account</mj-button>
        <mj-text mj-class="meta" padding="0 0 32px">Link valid for {{.Duration}} h.</mj-text>
        <mj-text mj-class="support" padding="0 0 16px"
          >If you didn’t request an account, you can ignore this email.</mj-text
        >
        <mj-text mj-class="support" padding="0 0 8px">You can also copy this link into your browser:</mj-text>
        <mj-text mj-class="support">
          <a class="fallback-link" href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
