<mjml lang="fr" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Créez votre compte Agora
MIME-Version: 1.0
Content-Type: multipart/related; type="text/html"; boundary="agora-related"

--agora-related
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Créez votre compte Agora</mj-title>
    <mj-preview>Terminez votre inscription.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#060b0e" css-class="mail">
    <mj-include path="../mj-header.mjml" />
    <mj-wrapper>
      <mj-section mj-class="card">
        <mj-column>
          <mj-text padding="0 0 8px"><h1>Créez votre compte</h1></mj-text>
          <mj-text padding="0 0 16px">Terminez votre inscription pour rejoindre Agora.</mj-text>
          <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}">Créer mon compte</mj-button>
          <mj-text mj-class="meta" padding="0 0 16px">Lien valable {{.Duration}} h.</mj-text>
          <mj-text mj-class="support">Si vous n’avez pas demandé de compte, vous pouvez ignorer ce message.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="24px 24px 48px">
      <mj-column>
        <mj-text mj-class="support" padding="0 0 8px">Vous pouvez aussi copier ce lien dans votre navigateur :</mj-text>
        <mj-text mj-class="support">
          <a class="fallback-link" href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
