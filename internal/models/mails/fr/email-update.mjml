<mjml lang="fr" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Confirmez votre nouvelle adresse courriel Agora
MIME-Version: 1.0
Content-Type: multipart/related; type="text/html"; boundary="agora-related"

--agora-related
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Confirmez votre nouvelle adresse courriel Agora</mj-title>
    <mj-preview>Confirmez cette adresse pour mettre à jour votre compte.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#060b0e" css-class="mail">
    <mj-include path="../mj-header.mjml" />
    <mj-wrapper>
      <mj-section mj-class="card">
        <mj-column>
          <mj-text padding="0 0 8px"><h1>Confirmez votre nouvelle adresse courriel</h1></mj-text>
          <mj-text padding="0 0 16px"
            >Vous avez demandé à changer l’adresse courriel de votre compte Agora. Confirmez cette adresse pour terminer
            la mise à jour.</mj-text
          >
          <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}&amp;source={{.Source}}"
            >Confirmer mon adresse courriel</mj-button
          >
          <mj-text mj-class="meta" padding="0 0 16px">Lien valable {{.Duration}} h.</mj-text>
          <mj-text mj-class="support"
            >Si vous n’êtes pas à l’origine de cette demande, ignorez ce message. Votre adresse courriel actuelle
            restera la même.</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="24px 24px 48px">
      <mj-column>
        <mj-text mj-class="support" padding="0 0 8px">Vous pouvez aussi copier ce lien dans votre navigateur :</mj-text>
        <mj-text mj-class="support">
          <a
            class="fallback-link"
            href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}&amp;source={{.Source}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}&amp;source={{.Source}}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
