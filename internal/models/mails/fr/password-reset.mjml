<mjml lang="fr" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Réinitialisez votre mot de passe Agora Storyverse
MIME-Version: 1.0
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Réinitialisez votre mot de passe Agora Storyverse</mj-title>
    <mj-preview>Choisissez un nouveau mot de passe pour votre compte.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#010203">
    <mj-include path="../mj-header.mjml" />
    <mj-wrapper padding="0 16px">
      <mj-section css-class="message-content" background-color="#161a1d" border-radius="12px" padding="32px">
        <mj-column>
          <mj-text padding="0 0 24px"><h1>Réinitialisez votre mot de passe</h1></mj-text>
          <mj-text
            >Vous avez demandé à réinitialiser le mot de passe de votre compte Agora Storyverse. Suivez le lien pour en
            choisir un nouveau.</mj-text
          >
          <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >Réinitialiser mon mot de passe</mj-button
          >
          <mj-text mj-class="meta" padding="0 0 32px">Lien valable {{.Duration}} h.</mj-text>
          <mj-text mj-class="support" padding="0"
            >Si vous n’êtes pas à l’origine de cette demande, ignorez ce message. Votre mot de passe restera le
            même.</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="24px 24px 0">
      <mj-column>
        <mj-text mj-class="support" padding="0 0 8px">Vous pouvez aussi copier ce lien dans votre navigateur :</mj-text>
        <mj-text mj-class="support" padding="0 0 32px">
          <a class="fallback-link" href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
