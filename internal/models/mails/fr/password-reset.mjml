<mjml lang="fr" dir="ltr">
  <!-- prettier-ignore -->
  <mj-raw position="file-start">
Subject: Réinitialise ton mot de passe Agora Storyverse
MIME-Version: 1.0
Content-Type: text/html; charset=UTF-8

<!-- Mail starts here -->
  </mj-raw>
  <mj-head>
    <mj-title>Réinitialise ton mot de passe Agora Storyverse</mj-title>
    <mj-preview>Choisis un nouveau mot de passe pour ton compte.</mj-preview>
    <mj-include path="../mj-theme.mjml" />
  </mj-head>
  <mj-body width="600px" background-color="#010203">
    <mj-include path="../mj-header.mjml" />
    <mj-wrapper padding="0 16px">
      <mj-section css-class="message-content" background-color="#161a1d" border-radius="12px" padding="32px">
        <mj-column>
          <mj-text mj-class="meta" padding="0 0 16px">Accès au compte</mj-text>
          <mj-text padding="0 0 24px"><h1>Réinitialise ton mot de passe</h1></mj-text>
          <mj-text
            >Tu as demandé à réinitialiser le mot de passe de ton compte Agora Storyverse. Suis le lien pour en choisir
            un nouveau.</mj-text
          >
          <mj-button href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >Réinitialiser mon mot de passe</mj-button
          >
          <mj-text mj-class="meta" padding="0 0 32px">Lien valable {{.Duration}} h.</mj-text>
          <mj-text mj-class="support" padding="0"
            >Si tu n’es pas à l’origine de cette demande, ignore ce message. Ton mot de passe restera le même.</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="24px 24px 0">
      <mj-column>
        <mj-text mj-class="support" padding="0 0 8px">Tu peux aussi copier ce lien dans ton navigateur :</mj-text>
        <mj-text mj-class="support" padding="0 0 32px">
          <a class="fallback-link" href="{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}"
            >{{.URL}}?shortCode={{.ShortCode}}&amp;target={{.Target}}</a
          >
        </mj-text>
        <mj-text
          font-family="Lora, Georgia, 'Noto Serif', serif"
          font-size="16px"
          font-style="italic"
          color="#a2a8ab"
          padding="0 0 48px"
        >
          Crée des mondes où l’on aime revenir.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
