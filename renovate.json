{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^builds\\/database\\.Dockerfile$/"],
      "matchStrings": [
        "ARG PGBACKREST_VERSION=(?<currentValue>[0-9.]+)\\s+ARG PGBACKREST_SHA256=(?<currentDigest>[a-f0-9]{64})\\s"
      ],
      "datasourceTemplate": "custom.pgbackrest",
      "depNameTemplate": "pgbackrest/pgbackrest"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^builds\\/database\\.Dockerfile$/"],
      "matchStrings": ["chainguard\\.dev/apko@(?<currentValue>v[0-9.]+)"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "chainguard-dev/apko"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^builds\\/database\\.apko\\.yaml$/"],
      "matchStrings": ["- (?<depName>[a-z0-9-]+)=(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "apk",
      "registryUrlTemplate": "https://packages.wolfi.dev/os?arch=x86_64"
    }
  ],
  "customDatasources": {
    "pgbackrest": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/pgbackrest/pgbackrest/releases?per_page=100",
      "transformTemplates": [
        "$[draft = false and prerelease = false and $substring(tag_name, 0, 8) = 'release/'].($version := $substringAfter(tag_name, 'release/'); $published := published_at; assets[name = 'pgbackrest-' & $version & '.tar.gz' and $match($string(digest), /^sha256:[a-f0-9]{64}$/)].{'version': $version, 'digest': $substring(digest, 7), 'releaseTimestamp': $published})",
        "{'releases': [$[$match(version, /^[0-9]+\\.[0-9]+(\\.[0-9]+)?$/)]], 'sourceUrl': 'https://github.com/pgbackrest/pgbackrest'}"
      ]
    }
  },
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)(?:podman-)?compose[^/]*\\.ya?ml$/"]
  },
  "gomod": {
    "managerFilePatterns": [
      "/(^|/)go\\.mod$/",
      "/(^|/)golangci-lint\\.mod$/",
      "/(^|/)gotestsum\\.mod$/",
      "/(^|/)mockery\\.mod$/"
    ]
  },
  "packageRules": [
    {
      "matchFileNames": ["builds/database.apko.yaml"],
      "matchPackageNames": ["/^postgresql-18/"],
      "groupName": "PostgreSQL runtime packages"
    },
    {
      "matchFileNames": ["golangci-lint.mod"],
      "additionalBranchPrefix": "golangci-lint-",
      "goGetDirs": ["."],
      "postUpgradeTasks": {
        "commands": [
          "rm -f golangci-lint.sum",
          "go get -modfile=golangci-lint.mod -tool github.com/golangci/golangci-lint/v2/cmd/golangci-lint",
          "go tool -modfile=golangci-lint.mod golangci-lint run ./... --fix"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["gotestsum.mod"],
      "additionalBranchPrefix": "gotestsum-",
      "goGetDirs": ["."],
      "postUpgradeTasks": {
        "commands": ["rm -f gotestsum.sum", "go get -modfile=gotestsum.mod -tool gotest.tools/gotestsum"],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["mockery.mod"],
      "additionalBranchPrefix": "mockery-",
      "goGetDirs": ["."],
      "postUpgradeTasks": {
        "commands": [
          "rm -f mockery.sum",
          "go get -modfile=mockery.mod -tool github.com/vektra/mockery/v3",
          "go tool -modfile=mockery.mod mockery"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["go.mod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchManagers": ["npm"],
      "postUpdateOptions": ["pnpmDedupe"],
      "postUpgradeTasks": {
        "commands": ["pnpm format:js"],
        "executionMode": "branch"
      }
    }
  ]
}
